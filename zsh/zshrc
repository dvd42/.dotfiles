# Auto-fetch origin whenever we cd into a git repo, rate-limited to once per
# 10 minutes per repo. Keeps origin/HEAD fresh so `claude --worktree` branches
# from the latest remote default. Runs in the background, invisible to you.
auto_fetch_origin() {
  local repo gitdir marker now last
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || return
  gitdir=$(git -C "$repo" rev-parse --git-dir 2>/dev/null) || return
  # Resolve relative gitdir paths (worktrees return relative to repo root)
  [[ "$gitdir" = /* ]] || gitdir="$repo/$gitdir"
  marker="$gitdir/.last-autofetch"
  now=$(date +%s)
  [[ -f "$marker" ]] && last=$(cat "$marker" 2>/dev/null) || last=0
  if (( now - last > 600 )); then
    (git -C "$repo" fetch --all --prune --quiet &) 2>/dev/null
    printf '%s' "$now" > "$marker"
  fi
}
autoload -U add-zsh-hook
