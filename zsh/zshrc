# Restore terminal state (color attributes, cursor visibility) after Claude
# Code exits — its TUI sometimes leaves the prompt rendered against stale
# attributes so the oh-my-posh theme looks "default" until you reload.
claude() {
  command claude "$@"
  local rc=$?
  printf '\e[0m\e[?25h'
  return $rc
}

